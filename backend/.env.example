# CodeSync Agent Configuration

# Server Binding (strictly bound to 127.0.0.1 for security)
PORT=4578
NODE_ENV=development

# Local Authentication Token (must match extension settings)
CODESYNC_TOKEN=codesync-local-dev-token

# Target DSA Git Repository (absolute path to your local git repository)
# Example (Windows): CODESYNC_REPO_PATH=C:\Users\ALLEN\dev\leetcode-solutions
# Example (macOS/Linux): CODESYNC_REPO_PATH=/home/user/dev/leetcode-solutions
CODESYNC_REPO_PATH=

# Optional: Auto-push commits to remote (true/false)
CODESYNC_AUTO_PUSH=false

# Optional: Commit message template
# Variables: {platform} (e.g. leetcode, geeksforgeeks), {problem} (e.g. Two-Sum)
CODESYNC_COMMIT_FORMAT=feat({platform}): add {problem}

# Optional: OpenAI API Key for AI explanation generation in README.md
# Leave blank to use standard placeholder README templates without AI
OPENAI_API_KEY=

# Optional: SQLite Database path (defaults to ~/.codesync/codesync.db)
# CODESYNC_DB_PATH=
