{
  "manifest_version": 3,
  "name": "GrindSync",
  "version": "1.0.0",
  "description": "Auto-capture accepted LeetCode & GFG solutions and sync them to GitHub with AI-powered diagrammatic explanations",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/problems/*",
        "*://*.leetcode.cn/problems/*",
        "*://*.geeksforgeeks.org/*",
        "*://practice.geeksforgeeks.org/*"
      ],
      "js": ["monaco-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.leetcode.com/problems/*",
        "*://*.leetcode.cn/problems/*",
        "*://*.geeksforgeeks.org/*",
        "*://practice.geeksforgeeks.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.leetcode.com/*",
    "*://*.leetcode.cn/*",
    "*://*.geeksforgeeks.org/*"
  ]
}
